#!/usr/bin/env python3
# Codex の会話記録（~/.codex/sessions）から、期間内のトークン使用量をセッションごと・依頼ごとに集計する。
# 応答ごとの使用量は token_usage_record に残る。同じ応答が重なって記録されることがあるため、response_id で1回と数える。
import argparse
import collections
import glob
import json
import os
import re
from datetime import date, datetime, time, timedelta

# 割合の重み。キャッシュ済み入力 0.1、出力 8 は API 単価の比（キャッシュなし入力を1とする）の目安。
WEIGHTS = {"uncached": 1.0, "cached": 0.1, "output": 8.0}
SESSION_ID = re.compile(r"rollout-\d{4}-\d\d-\d\dT\d\d-\d\d-\d\d-([0-9A-Za-z]+)")


def fmt(n):
    if n >= 1e6:
        return f"{n / 1e6:.1f}M"
    if n >= 1e3:
        return f"{n / 1e3:.1f}k"
    return str(int(n))


def parse_time(stamp):
    return datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone()


def weight(row):
    return sum(row[key] * value for key, value in WEIGHTS.items())


def user_text(payload):
    item = payload.get("item") or {}
    if payload.get("type") != "item_completed" or item.get("type") != "UserMessage":
        return None
    text = " ".join(b.get("text", "") for b in item.get("content") or [] if b.get("type") == "text")
    return " ".join(text.split())[:40] or None


def collect(root, start, end):
    rows = []
    for path in glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True):
        if os.path.getmtime(path) < start.timestamp():
            continue
        match = SESSION_ID.search(os.path.basename(path))
        session = (match.group(1) if match else os.path.basename(path))[:8]
        project = "?"
        seen = set()
        prompt, prompt_index = "（最初の依頼の前）", 0
        try:
            lines = open(path, encoding="utf-8").readlines()
        except OSError:
            continue
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            payload = entry.get("payload") or {}
            if entry.get("type") == "session_meta" and payload.get("cwd"):
                project = os.path.basename(payload["cwd"])
            text = user_text(payload)
            if text:
                prompt, prompt_index = text, prompt_index + 1
            if entry.get("type") != "token_usage_record" or not entry.get("timestamp"):
                continue
            response = payload.get("response_id")
            if response in seen or not start <= parse_time(entry["timestamp"]) < end:
                continue
            seen.add(response)
            usage = payload.get("usage") or {}
            cached = usage.get("cached_input_tokens", 0)
            rows.append({
                "project": project, "session": session, "time": parse_time(entry["timestamp"]),
                "prompt": (session, prompt_index, prompt),
                "input": usage.get("input_tokens", 0),
                "uncached": usage.get("input_tokens", 0) - cached,
                "cached": cached,
                "output": usage.get("output_tokens", 0),
                "reasoning": usage.get("reasoning_output_tokens", 0),
            })
    return rows


def group(rows, key):
    groups = collections.OrderedDict()
    for row in sorted(rows, key=lambda r: r["time"]):
        g = groups.setdefault(key(row), {"rows": [], "uncached": 0, "cached": 0, "output": 0})
        g["rows"].append(row)
        for field in WEIGHTS:
            g[field] += row[field]
    return groups


def main():
    parser = argparse.ArgumentParser(description="Codex のトークン使用量を集計する")
    parser.add_argument("--since", type=date.fromisoformat, default=date.today(), help="開始日 YYYY-MM-DD（省略時は今日）")
    parser.add_argument("--until", type=date.fromisoformat, help="終了日 YYYY-MM-DD（省略時は開始日）")
    parser.add_argument("--by", choices=["session", "prompt"], default="session", help="セッションごとか依頼ごとか")
    parser.add_argument("--breakdown", action="store_true", help="Codex では未対応（Claude と引数をそろえるために受け付ける）")
    args = parser.parse_args()
    until = args.until or args.since
    start = datetime.combine(args.since, time()).astimezone()
    end = datetime.combine(until + timedelta(days=1), time()).astimezone()
    root = os.environ.get("CODEX_SESSIONS_DIR") or os.path.expanduser("~/.codex/sessions")
    rows = collect(root, start, end)

    total = {field: sum(r[field] for r in rows) for field in ("uncached", "cached", "output", "reasoning")}
    total_weight = weight(total) or 1
    print(f"Codex {args.since}〜{until}")
    print(
        f"合計: 応答 {len(rows)} 回 / キャッシュなし入力 {fmt(total['uncached'])} / キャッシュ済み入力 {fmt(total['cached'])}"
        f" / 出力 {fmt(total['output'])}（うち推論 {fmt(total['reasoning'])}）"
    )
    if args.breakdown:
        print("読み直しの内訳は Codex では未対応")
    if not rows:
        return
    print("割合は API 単価の比で重み付けした目安（キャッシュ済み入力 0.1、出力 8）")
    print()
    if args.by == "session":
        print("| # | プロジェクト | セッション | 時間 | 応答 | 平均の長さ | 最大 | キャッシュ済み入力 | 出力 | 割合 |")
        print("|---|---|---|---|---|---|---|---|---|---|")
        groups = group(rows, lambda r: (r["project"], r["session"]))
        ordered = sorted(groups.items(), key=lambda kv: -weight(kv[1]))
        for i, ((project, session), g) in enumerate(ordered, 1):
            sizes = [r["input"] for r in g["rows"]]
            span = f"{g['rows'][0]['time']:%m/%d %H:%M}–{g['rows'][-1]['time']:%H:%M}"
            print(
                f"| {i} | {project} | {session} | {span} | {len(sizes)} | {fmt(sum(sizes) / len(sizes))} | {fmt(max(sizes))}"
                f" | {fmt(g['cached'])} | {fmt(g['output'])} | {weight(g) / total_weight * 100:.0f}% |"
            )
    else:
        print("| # | プロジェクト | 時刻 | 依頼 | 応答 | キャッシュ済み入力 | 出力 | 割合 |")
        print("|---|---|---|---|---|---|---|---|")
        groups = group(rows, lambda r: r["prompt"])
        for i, ((session, _, prompt), g) in enumerate(groups.items(), 1):
            first = g["rows"][0]
            print(
                f"| {i} | {first['project']} | {first['time']:%m/%d %H:%M} | {prompt} | {len(g['rows'])}"
                f" | {fmt(g['cached'])} | {fmt(g['output'])} | {weight(g) / total_weight * 100:.0f}% |"
            )


if __name__ == "__main__":
    main()
